[global]
    monitor = 0
    follow = keyboard
    width = 360
    height = 120
    origin = top-right
    offset = 12x42
    frame_width = 2
    frame_color = "#458588"
    font = JetBrainsMono Nerd Font Mono 10
    corner_radius = 4

[urgency_low]
    background = "#282828"
    foreground = "#ebdbb2"

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"

[urgency_critical]
    background = "#cc241d"
    foreground = "#fbf1c7"
