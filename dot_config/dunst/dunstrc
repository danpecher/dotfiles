[global]
    monitor = 0
    follow = keyboard
    width = 380
    height = 140
    origin = top-right
    offset = 14x56
    notification_limit = 5
    gap_size = 8
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    frame_color = "#504945"
    separator_height = 1
    separator_color = frame
    font = JetBrainsMono Nerd Font Mono 10
    corner_radius = 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    highlight = "#83a598"
    timeout = 6

[urgency_low]
    background = "#1d2021"
    foreground = "#a89984"
    frame_color = "#3c3836"

[urgency_normal]
    background = "#282828"
    foreground = "#ebdbb2"
    frame_color = "#83a598"

[urgency_critical]
    background = "#cc241d"
    foreground = "#fbf1c7"
    frame_color = "#fb4934"
    timeout = 0
