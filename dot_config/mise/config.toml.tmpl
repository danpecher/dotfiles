{{- $activeProfile := env "PROFILE" -}}
{{- if not (has $activeProfile (list "personal" "minimal")) -}}
{{-   $activeProfile = get . "profile" | default "personal" -}}
{{- end -}}
# mise global configuration
# Managed by chezmoi

[settings]
auto_install = true
verbose = false
ruby.compile = false  # use mise's precompiled Ruby distribution

[tools]
node = "26.7.0"
python = "3.14.2"
ruby = "4.0.6"
java = "21.0.2"
uv = "0.12.3"
gradle = "9.7.0"
pnpm = "11.21.0"
{{ if eq .chezmoi.os "linux" -}}
starship = "latest"
lazygit = "latest"
yazi = "latest"
{{ end -}}

[env]
EDITOR = "nvim"
VISUAL = "nvim"
PAGER = "less"
LESS = "-R"  # enables color output
LANG = "en_US.UTF-8"
LC_ALL = "en_US.UTF-8"
CLICOLOR = "1"  # colored ls output on macOS
GREP_OPTIONS = "--color=auto"
HOMEBREW_NO_ANALYTICS = "1"

# Node
NODE_OPTIONS = "--max-old-space-size=4096"

# Python
PYTHONDONTWRITEBYTECODE = "1"  # no .pyc files
PIP_REQUIRE_VIRTUALENV = "true"  # prevent accidental global installs
