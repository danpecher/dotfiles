configuration {
    modi: "drun,run,window";
    show-icons: true;
    terminal: "footclient";
    font: "JetBrainsMono Nerd Font Mono 12";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
    drun-display-format: "{name}";
}

* {
    background: #1d2021f2;
    surface: #282828;
    surface-alt: #3c3836;
    foreground: #ebdbb2;
    muted: #a89984;
    accent: #83a598;
    urgent: #fb4934;
}

window {
    width: 42%;
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
    padding: 14px;
    background-color: @background;
}

mainbox {
    spacing: 12px;
    background-color: transparent;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 11px 14px;
    border-radius: 9px;
    background-color: @surface-alt;
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    placeholder: "Search…";
    placeholder-color: @muted;
    text-color: @foreground;
    background-color: transparent;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
    spacing: 4px;
    scrollbar: false;
    border: 0px;
    background-color: transparent;
}

element {
    spacing: 12px;
    padding: 9px 11px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
}

element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @foreground;
}

element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}

element selected.normal,
element selected.active {
    background-color: @accent;
    text-color: #1d2021;
}

element selected.urgent {
    background-color: @urgent;
    text-color: #fbf1c7;
}

element-icon {
    size: 28px;
    background-color: inherit;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
}
