# Brewfile.minimal - work VM setup
# Run: brew bundle --file=Brewfile.minimal

brew "git"
brew "gh"
brew "chezmoi"
brew "mise"
brew "neovim"
brew "ripgrep"
brew "fd"
brew "fzf"
brew "bat"
brew "eza"
brew "zoxide"
brew "jq"
brew "starship"
brew "git-delta"
brew "lazygit"
brew "trash"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

cask "ghostty"
cask "visual-studio-code"
cask "raycast"
cask "font-fira-code-nerd-font"
cask "font-jetbrains-mono-nerd-font"
cask "font-iosevka-nerd-font"
cask "font-symbols-only-nerd-font"
